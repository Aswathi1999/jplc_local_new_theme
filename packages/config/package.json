{
  "name": "@jplc/config",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.js"
    },
    "./tailwind": {
      "types": "./tailwind/index.d.ts",
      "default": "./tailwind/index.js"
    },
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/nestjs.json": "./tsconfig/nestjs.json"
  },
  "typesVersions": {
    "*": {
      "tailwind": [
        "./tailwind/index.d.ts"
      ],
      "eslint": [
        "./eslint/index.d.ts"
      ]
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  }
}
